{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(vendor|meshes|fonts|img|samples)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ]
}
